rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getSuperAdminUid() {
      return "hgN2L87pd4OaKWQTTBQQNfTq4HZ2";
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.uid == getSuperAdminUid();
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSuperAdmin() || (isAuthenticated() && getUserData().role in ['admin', 'super_admin']);
    }

    function hasValidOrg(data) {
      return data.organizationId == "kn_foundation";
    }

    // Users Collection
    match /users/{userId} {
      // Anyone authenticated in kn_foundation can view members
      allow read: if isAuthenticated();

      // Users can register their own initial profile as 'member'
      allow create: if isAuthenticated() 
        && request.auth.uid == userId
        && hasValidOrg(request.resource.data)
        && (isSuperAdmin() || request.resource.data.role == "member");

      // Super Admin can update any user's role and status
      // Admins can activate/deactivate members
      // Members can only update their own basic profile info (name, phone, address, photoURL)
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'organizationId'])) ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'organizationId', 'status', 'totalCapitalContributed', 'profitSharePercentage']))
      );

      allow delete: if isSuperAdmin();
    }

    // Capital Contributions Collection
    match /capitalContributions/{contribId} {
      // Members can read their own or admins can read all
      allow read: if isAuthenticated() && (isAdmin() || resource.data.memberId == request.auth.uid);

      // Only admins or super admins can create, update, delete capital records
      allow create: if isAdmin() && hasValidOrg(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Business Projects Collection
    match /projects/{projectId} {
      // All authenticated members can view projects
      allow read: if isAuthenticated();

      // Only admins can create or modify projects
      allow create: if isAdmin() && hasValidOrg(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Organization Expenses Collection
    match /expenses/{expenseId} {
      // All members can inspect organization expenses for financial transparency
      allow read: if isAuthenticated();

      // Only admins can add or update expenses
      allow create: if isAdmin() && hasValidOrg(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Profit Distributions Collection
    match /profitDistributions/{distId} {
      // All members can read profit distributions
      allow read: if isAuthenticated();

      // Only admins can create distributions
      allow create: if isAdmin() && hasValidOrg(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Notices Collection
    match /notices/{noticeId} {
      // All members can read notices
      allow read: if isAuthenticated();

      // Only admins can post or edit notices
      allow create: if isAdmin() && hasValidOrg(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      // Only participants can read or update conversation
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participantIds);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participantIds);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participantIds);
      allow delete: if isAdmin();

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId;
        allow update: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
        allow delete: if isAdmin();
      }
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      // User can read and update their own notifications
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == "all");
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
